# Google Cloud Vision API 凭证文件路径
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# Azure Storage 配置（敏感信息已在Azure App Service中设置）
# AZURE_STORAGE_CONNECTION_STRING=在Azure App Service中设置
AZURE_STORAGE_CONTAINER=models

# Spotify API 凭证（敏感信息已在Azure App Service中设置）
# SPOTIFY_CLIENT_ID=在Azure App Service中设置
# SPOTIFY_CLIENT_SECRET=在Azure App Service中设置

# 模型配置
MODEL_PATH=./models/googlenet_places365
ENABLE_SCENE_RECOGNITION=true
ENABLE_EMOTION_ANALYSIS=true

# API 配置
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif

# 缓存配置
ENABLE_REDIS_CACHE=false
REDIS_URL=redis://localhost:6379
